{
  "name": "@softbook/cet-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build_web_release.mjs",
    "build:bundle": "tsc -b && vite build && node scripts/verify-production-boundary.mjs",
    "dev": "vite",
    "lint": "eslint src --max-warnings=0",
    "pretest": "node ../../scripts/test_build_web_release_runtime_config.mjs && node --test ../../scripts/test_run_local_product.mjs ../../scripts/test_local_learning_state.mjs ../../scripts/test_design_refinement.mjs",
    "product:local": "npm run build:backend && npm run start:backend",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "test:browser:transport": "node scripts/test-browser-transport.mjs",
    "build:local": "npm run build:backend",
    "start:local": "npm run start:backend",
    "build:backend": "tsc -b && vite build --mode backend --outDir dist-backend",
    "start:backend": "node ../../scripts/run_local_backend.mjs",
    "build:device": "tsc -b && vite build --mode device --outDir dist-local",
    "start:device": "node ../../scripts/serve_local_study.mjs",
    "product:receiver": "node ../../scripts/run_local_product.mjs --target web"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.12.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "playwright-core": "1.63.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.52.0",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
