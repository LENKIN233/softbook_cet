{
  "name": "com.softbook.cet",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release:signed": "node ../../scripts/build_android_signed_release.mjs",
    "android:release:unsigned": "cd android && ./gradlew :app:verifyReleaseSigningBoundary :app:assembleRelease -PsoftbookRequireUnsignedRelease=true --no-daemon",
    "e2e:android:maestro": "maestro test e2e/maestro/android-remote-smoke.yaml",
    "e2e:ios:maestro": "maestro test e2e/maestro/ios-smoke.yaml",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "design-metadata-leak-scan": "node ../../scripts/check_design_metadata_leaks.mjs",
    "metadata-leak-scan": "node scripts/check-metadata-leaks.mjs",
    "postinstall": "node ../../scripts/normalize_react_native_podspecs.mjs && node ../../scripts/normalize_minimatch_brace_expansion.mjs",
    "pretest": "npm run metadata-leak-scan && npm run test:brace-expansion-compat",
    "start": "react-native start",
    "test": "jest",
    "test:audio-bundle-candidate-acceptance": "jest --config jest.audio-bundle-candidate-acceptance.config.js --runInBand --no-watchman",
    "test:controlled-pilot-acceptance": "jest --config jest.controlled-pilot-acceptance.config.js --runInBand --no-watchman",
    "test:brace-expansion-compat": "node ../../scripts/verify_minimatch_brace_expansion.mjs && node scripts/verify-modern-minimatch.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ed25519": "3.1.0",
    "@noble/hashes": "2.2.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/new-app-screen": "0.85.2",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-blob-util": "0.24.10",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "cosmiconfig": {
      "js-yaml": "4.3.1"
    },
    "eslint": {
      "js-yaml": "4.3.1"
    }
  },
  "engines": {
    "node": ">= 22.13.0"
  }
}
