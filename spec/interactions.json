{
  "version": "vnext-5",
  "audio_is_interaction_family": false,
  "interaction_contract_status": "core_content_contract",
  "source_anchors": {
    "audio_presentation_policy": "不自动播放，没有字幕（背面可以有）"
  },
  "audio_binding_policy": {
    "audio_must_be_available_on_all_release_targets": true,
    "audio_is_not_forced_by_any_specific_interaction_family": true,
    "audio_is_front_content_for": [
      "listening_cards",
      "some_other_cards_when_content_requires_it"
    ],
    "auto_play": false,
    "front_side_subtitles": false,
    "back_side_text_or_transcript_may_exist": true
  },
  "audio_resource_contract": {
    "card_payload_contains": [
      "asset_id",
      "sha256",
      "duration_ms",
      "optional_back_side_transcript"
    ],
    "card_payload_must_not_contain_download_url": true,
    "download_url_resolution": "authenticated_content_manifest_bound_to_exact_track_and_content_version",
    "resource_integrity": "signed_manifest_descriptor_plus_downloaded_byte_sha256",
    "playback_trigger": "explicit_user_action_only",
    "playback_authority": "the_mobile_player_binds_each_audio_selection_to_the_exact_server_selection_id_or_an_explicit_local_attempt_identity_and_each_new_prepare_to_a_controller_instance_scoped_playback_nonce",
    "native_event_rule": "ended_error_and_interruption_events_change_visible_state_only_when_their_exact_playback_nonce_is_still_current_while_pause_and_resume_within_one_selection_retain_that_nonce",
    "lifecycle_interruption_rule": "iOS_background_or_audio_session_interruption_binds_and_invalidates_the_exact_current_pending_ready_or_playing_native_generation_stops_it_and_emits_one_exact_tokened_requires_prepare_event_so_delayed_JS_AppState_delivery_cannot_autoplay; Android_host_pause_does_the_same_for_pending_or_ready_before_first_play_while_any_exact_token_with_play_requested_is_paused_and_emits_interruption_without_relying_on_isPlaying_so_buffering_or_focus_wait_cannot_activate_in_background"
  },
  "expansion_rule": "new interactions may exist, but must be specified here before content production depends on them",
  "interactions": [
    {
      "id": "flip",
      "name": "翻面",
      "kind": "core",
      "scoring_mode": "light_self_assess",
      "supports_audio": "optional_resource",
      "supports_hint_layer": true,
      "required_fields": ["front", "analysis"],
      "notes": "适合知识点识别与短解释"
    },
    {
      "id": "multiple_choice",
      "name": "四选一",
      "kind": "core",
      "scoring_mode": "auto",
      "supports_audio": "optional_resource",
      "supports_hint_layer": true,
      "required_fields": ["front", "options", "answer_key.correct_option"],
      "notes": "适合明确辨析"
    },
    {
      "id": "lock",
      "name": "开锁",
      "kind": "core",
      "scoring_mode": "auto",
      "supports_audio": "optional_resource",
      "supports_hint_layer": true,
      "required_fields": ["front", "lock_slots", "answer_key.lock_pattern"],
      "notes": "适合调整多个位置，只有全部正确时才开锁"
    },
    {
      "id": "elimination",
      "name": "消除",
      "kind": "core",
      "scoring_mode": "auto",
      "supports_audio": "optional_resource",
      "supports_hint_layer": true,
      "required_fields": ["front", "elimination_items", "answer_key.correct_items"],
      "notes": "适合提取句子主干或剥离干扰内容"
    },
    {
      "id": "swipe",
      "name": "滑动",
      "kind": "core",
      "scoring_mode": "auto",
      "supports_audio": "optional_resource",
      "supports_hint_layer": true,
      "required_fields": ["front", "swipe_states", "answer_key.correct_state"],
      "notes": "适合低成本双态判断"
    },
    {
      "id": "hint_layer",
      "name": "提示层",
      "kind": "enhancement",
      "scoring_mode": "none",
      "supports_audio": false,
      "supports_hint_layer": false,
      "required_fields": ["hint_layer.content", "hint_layer.reveal_gesture"],
      "notes": "附着于其他核心交互，以下滑或扳动卡片露出物理空间的一片提示区域；不能单独作为卡型"
    }
  ],
  "not_core_for_v1": [
    {
      "id": "audio_timing_family",
      "reason": "音频是需要的，但不把时机类音频交互作为 V1 核心交互家族"
    }
  ]
}
