  "progressive_disclosure_policy": {
    "default_behavior": "Use authority-map and doc-manifest to locate the current task owner; read_paths are starting points, not ordered chains or a mandatory reading checklist.",
    "scope": "Read only sections that affect the task. Consult requirement-memory when changing product definitions or resolving intent, delivery policy when delivering changes, runtime-boundaries for a touched runtime boundary, and archived records only for a concrete historical question.",
    "escalate_when": [
      "a_real_cross_domain_dependency_affects_the_result",
      "owners_conflict_or_leave_a_material_gap",
      "observed_behavior_contradicts_the_current_contract"
    ],
    "forbidden_behavior": [
      "loading_the_entire_active_tree_by_default",
      "treating_historical_workflow_or_design_as_immutable_product_truth",
      "editing_a_mirrored_fact_without_checking_its_owner_in_authority_map"
    ]
  },
  "task_briefs": {
    "product": {
      "owner": "spec/product-core.json",
      "focus": "Identify the learner benefit and preserve the product concepts owned by the relevant specs. Separate intended outcomes from the current implementation.",
      "done_when": "The requested decision is supported by the current user goal and product evidence, with material assumptions and unresolved questions named."
    },
    "coding": {
      "focus": "Change the affected behavior and verify it through task-relevant tests and actual execution where needed.",
      "done_when": "The requested behavior works, related invariants remain intact, and known limitations are reported."
    },
    "card_content_handoff": {
      "owner": "infra/cloudbase/mobile-runtime-contract.md",
      "focus": "Consume the card make export, verify import and catalog integrity, and exercise affected content in the product. Candidate production and approval stay upstream.",
      "done_when": "The requested handoff has a traceable payload and validated import/runtime result; unverified content or release claims remain explicit."
    },
    "user_facing_ui_implementation": {
      "owner": "spec/machine-acceptance.json#harness_strategy.experience_acceptance",
      "focus": "Use current design and implementation as revisable baselines. Identify the user task, information priority, feedback and recovery; make ordinary design and implementation improvements together.",
      "done_when": "Observed behavior and captures support the intended improvement on affected surfaces; usability and aesthetic findings are resolved or stated, even when no old rule was violated."
    },
    "interaction_motion_design": {
      "owner": "spec/interactions.json",
      "focus": "Verify the intended action, visible feedback, interruption/recovery and reduced-motion behavior. Use sketches or storyboards when they resolve a real uncertainty.",
      "done_when": "The affected interaction is understandable and operable; motion clarifies state without delaying or blocking the task."
    },
    "physical_space_design": {
      "owner": "spec/knowledge-map.json",
      "related_owner": "spec/space-operations.json",
      "focus": "Keep library/group/box/card ownership, favorite tags, sleep/wake effects and Learning-to-Space continuity meaningful. Choose the visible hierarchy and layout for the device and task.",
      "done_when": "A user can understand current position, inspect contents and return to learning without losing relevant state; permitted operations preserve knowledge ownership."
    },
    "design_search": {
      "activation": "Optional when a material design uncertainty warrants alternatives.",
      "focus": "Compare plausible alternatives against observed learner tasks. Vary the assumption most likely to hide a weakness; keep useful findings without requiring a candidate population or promotion ledger.",
      "done_when": "Evidence supports the chosen improvement or explains the remaining uncertainty."
    },
    "review": {
      "owner": "spec/machine-acceptance.json",
      "focus": "Review concrete learner value, comprehension, visual hierarchy, interaction cost and correctness alongside security/data risks. Existing anti-patterns are prompts, not an exhaustive definition of quality.",
      "done_when": "Findings explain observed impact and evidence, covered risks are clear, and unexecuted paths remain unverified."
    },
    "workspace_boundary": {
      "owner": "spec/workspace-boundary.json",
      "focus": "Use task-relevant active sources, preserve existing work, and cross generated/archive/external boundaries only for a concrete debug or handoff need.",
      "done_when": "The task uses the needed context and repository state without loading unrelated history or changing another task’s work."
    },
    "harness_architecture": {
      "owner": "spec/harness-architecture.json",
      "focus": "Preserve validator isolation, declared capabilities, truthful partial results and runtime evidence boundaries. Remove process assertions when they do not protect a demonstrated failure.",
      "done_when": "Representative valid variants pass, meaningful failure cases still fail, and observed validator results establish the affected capability and side-effect boundaries."
    }
  },
  "governance": {
    "main_branch_policy": {
      "branch_name": "main",
      "role": "read_only_integration_branch",
      "direct_development": "forbidden",
      "direct_merge_commit": "forbidden",
      "direct_push": "forbidden",
      "dirty_checkout": "forbidden",
      "allowed_topic_branch_prefixes": [
        "infra/",
        "shell/",
        "module/",
        "cross/",
        "fix/"
      ]
    },
    "local_guard": {
      "install_command": "./scripts/install_git_hooks.sh",
      "hooks_path": ".githooks",
      "guard_script": "scripts/guard_main_branch.sh",
      "hook_wrapper_root_resolution": "git rev-parse --path-format=absolute --git-common-dir",
      "lfs_install_command": "git lfs install --skip-repo",
      "lfs_pre_push_command": "git lfs pre-push \"$@\"",
      "hooks_config_scope": "worktree",
      "bypass_env": "SOFTBOOK_ALLOW_MAIN_BYPASS",
      "required_hooks": [
        {
          "path": ".githooks/pre-commit",
          "action": "pre-commit",
          "behavior": "block_commit_on_main"
        },
        {
          "path": ".githooks/pre-merge-commit",
          "action": "pre-merge-commit",
          "behavior": "block_local_merge_commit_on_main"
        },
        {
          "path": ".githooks/pre-push",
          "action": "pre-push",
          "behavior": "block_push_from_local_main_to_remote_main"
        },
        {
          "path": ".githooks/post-checkout",
          "action": "post-checkout",
          "behavior": "block_dirty_checkout_to_main_and_warn_on_clean_checkout"
        }
      ]
    },
    "remote_guard": {
      "provider": "github",
      "repository": "LENKIN233/softbook_cet",
      "protected_branch": "main",
      "repository_settings": {
        "default_branch": "main",
        "allow_auto_merge": true,
        "delete_branch_on_merge": true,
        "allow_squash_merge": true,
        "allow_merge_commit": false,
        "allow_rebase_merge": false
      },
      "require_pull_request": true,
      "required_approving_review_count": 0,
      "required_status_checks": [
        "backend-contract",
        "design-artifact-gate",
        "validate-harness",
        "mobile-quality",
        "web-quality",
        "dependency-security",
        "ios-release",
        "android-release",
        "repo-health",
        "evidence-archive"
      ],
      "require_strict_status_checks": true,
      "allow_force_pushes": false,
      "allow_deletions": false
    },
    "external_content_workspace": {
      "name": "card make",
      "absolute_path": "/Users/lenkin/programing/card make",
      "sibling_path_from_repo": "../card make",
      "role": "upstream_candidate_card_content_production_workspace",
      "softbook_cet_role": "card_payload_consumer_importer_auditor_and_runtime_validator",
      "handoff_contract": "infra/cloudbase/mobile-runtime-contract.md",
      "catalog_authority": "spec/box-catalog.json",
      "approval_boundary": "candidate_or_approved_content_status_lives_in_card_make_not_softbook_cet",
      "forbidden_in_softbook_cet": [
        "generating_candidate_card_content",
        "marking_card_batches_as_approved",
        "using_softbook_cet_dev_seed_cards_as_release_content_quantity"
      ],
      "allowed_in_softbook_cet": [
        "dry_run_import_card_payloads",
        "apply_imports_after_explicit_or_existing_validated_handoff",
        "audit_cloudbase_card_sources",
        "run_runtime_smoke_against_imported_payloads",
        "report_release_content_gap_delta"
      ]
    },
    "repo_delivery_contract": {
      "owner": "spec/repo-delivery-contract.json",
      "execution_rule": "Follow the delivery owner for the current task and respect explicit local-only scope; do not duplicate its review, PR or release workflow here.",
      "experience_owner": "spec/machine-acceptance.json#harness_strategy.experience_acceptance"
    }
  },
