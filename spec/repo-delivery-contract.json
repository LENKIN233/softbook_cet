{
  "version": "vnext-18",
  "purpose": "Lean repository delivery contract for model-owned changes: topic branch, pull request, exact-diff model review, task-relevant required checks, and automatic merge without human approval.",
  "delivery_defaults": {
    "code_change_tasks": {
      "default_strategy": "topic_branch_commit_pull_request_agent_review_auto_merge",
      "topic_branch_required": true,
      "allowed_topic_branch_prefixes": [
        "infra/",
        "shell/",
        "module/",
        "cross/",
        "fix/"
      ],
      "local_only_requires_explicit_user_instruction": true,
      "pull_request_required_unless_local_only": true,
      "model_review_required_before_merge": true,
      "tracked_agent_run_record_required_before_merge": false,
      "human_or_user_approval_required_before_merge": false,
      "auto_merge_after_model_review_and_green_gates": true,
      "merge_blockers": [
        "blocking_review_findings",
        "model_review_missing_or_blocking",
        "required_gates_not_green",
        "pull_request_or_merge_permission_failure"
      ],
      "if_pull_request_cannot_be_created": "handoff_branch_commit_validation_and_blocker"
    }
  },
  "pull_request_contract": {
    "target_branch": "main",
    "default_action": "open_or_update_pull_request_then_review_and_merge_when_green",
    "required_body_sections": [
      "当前任务引用的 spec",
      "变更摘要",
      "验证",
      "Model review"
    ],
    "validation_record_policy": {
      "skip_remote_guard_is_ci_only": true,
      "skip_remote_guard_only_record_is_merge_blocker": false,
      "required_checks_must_pass_before_merge": true,
      "required_checks_do_not_replace_product_judgment": true
    },
    "visual_output_rule": "For affected user-facing tasks, describe observed behavior and remaining limitations in the existing validation section; the review declaration is not experience evidence.",
    "user_facing_ui_design_gate": {
      "applies_when": "pull_request_changes_user_facing_UI_or_visual_state",
      "experience_acceptance_owner": "spec/machine-acceptance.json#harness_strategy.experience_acceptance",
      "design_artifacts": "Existing designs and task-local sketches are revisable context. Creating or citing an artifact is not a prerequisite for ordinary fixes and does not prove product quality.",
      "validation_record": "Use the existing 验证 section for the affected user task, actual observations, and unverified limits. No per-screen checklist or duplicated design record is required.",
      "scope": "Choose affected journeys and platforms from the actual change; report missing execution explicitly rather than treating a document or another platform as proof."
    },
    "card_content_handoff_gate": {
      "applies_when": "pull_request_changes_repository_dev_card_content_or_card_payload_seed",
      "direct_content_production_without_external_handoff": "delivery_blocker",
      "watched_files": [
        "apps/mobile/src/learning/localCardRecords.ts"
      ],
      "accepted_handoff_sources": [
        "external_workspace:/Users/lenkin/programing/card make",
        "/Users/lenkin/programing/card make",
        "../card make"
      ],
      "pull_request_must_state": [
        "card_make_handoff_source",
        "dry_run_import_result_or_catalog_audit_result_or_runtime_smoke_result_or_release_content_gap_delta"
      ],
      "accepted_validation_evidence": [
        "dry_run_import_result",
        "catalog_audit_result",
        "runtime_smoke_result",
        "release_content_gap_delta",
        "infra/cloudbase/import-card-source.mjs",
        "infra/cloudbase/audit-card-sources.mjs",
        "infra/cloudbase/smoke-softbook-api.mjs",
        "scripts/report_release_content_gap.mjs"
      ]
    },
    "agent_run_record_policy": {
      "required_before_merge": false,
      "required_for": [],
      "lifecycle": "frozen_historical_archive",
      "storage": "docs/agent-runs/",
      "pr_body_field": "Run record",
      "allowed_placeholder_before_review": "N/A",
      "replacement": "concise_pull_request_summary_exact_diff_model_review_and_domain_specific_external_evidence"
    },
    "local_quality_feedback": {
      "architecture_owner": "spec/harness-architecture.json#local_gate_runner_contract",
      "entrypoint": "scripts/run_local_gates",
      "profiles": [
        "dev",
        "pr",
        "release"
      ],
      "pr_profile_requires_unique_current_pull_request": true,
      "release_profile_requires_macos": true,
      "deferred_cannot_satisfy_pr_or_release": true,
      "safe_exceptions_must_remain_visible": true,
      "may_replace_required_github_checks": false,
      "may_update_model_review_or_launch_readiness": false
    },
    "post_merge_local_sync_policy": {
      "remote_merge_state_is_authoritative": true,
      "verify_remote_state_with": [
        "gh pr view --json state,mergedAt,mergeCommit,statusCheckRollup",
        "git ls-remote origin refs/heads/main"
      ],
      "if_local_main_worktree_exists_and_is_clean": "fast_forward_local_main_worktree_to_origin_main",
      "if_local_main_worktree_is_dirty": "do_not_overwrite_report_dirty_main_worktree_as_workspace_hygiene_blocker",
      "local_worktree_lock_error_after_merge": "not_remote_merge_failure_when_github_pr_state_is_MERGED"
    }
  },
  "ci_contract": {
    "workflow_path": ".github/workflows/pr-gates.yml",
    "pull_request_template_path": ".github/pull_request_template.md",
    "machine_acceptance": {
      "owner": "spec/machine-acceptance.json",
      "required_status_check": "validate-harness",
      "review_schema": "exact-diff-review.v1",
      "review_method": "task_risk_based_exact_diff_review",
      "external_model_api_required": false,
      "pr_description_records_review": true,
      "exact_pull_request_head_binding_required": true,
      "human_or_user_environment": null,
      "tracked_run_record_required": false,
      "sensitive_scope_policy": "Review task-specific failure modes with relevant execution, security, integrity, rollback and external evidence checks; depth follows risk rather than a fixed pass count.",
      "declaration_boundary": "The PR record validates declaration consistency and exact head binding only. It does not prove that review occurred, semantic quality, independent provenance, or external facts.",
      "accepted_legacy_review_schemas": [
        "single-task-dual-perturbation-review.v1"
      ],
      "legacy_review_record_policy": "Existing PRs may retain this legacy declaration without reauthoring historical review metadata. Validate exact head, top-level status and summary, and every declared run decision and blocking-findings list. Do not require a fixed run count or interpret run/model/time metadata as verified provenance. New records use review_schema."
    },
    "remote_repository_health": {
      "workflow_job": "repo-health",
      "triggers": [
        "schedule",
        "workflow_dispatch"
      ],
      "actions_secret": "REPO_HEALTH_TOKEN",
      "credential_type": "fine_grained_personal_access_token",
      "repository_scope": "LENKIN233/softbook_cet",
      "trusted_ref": "refs/heads/main",
      "secret_exposure_policy": "trusted_ref_remote_step_only",
      "untrusted_remote_ref_policy": "fail_closed_without_secret",
      "required_repository_permissions": [
        "Administration: read",
        "Actions: read"
      ],
      "required_repository_settings": {
        "default_branch": "main",
        "allow_auto_merge": true,
        "delete_branch_on_merge": true,
        "allow_squash_merge": true,
        "allow_merge_commit": false,
        "allow_rebase_merge": false
      },
      "github_token_fallback_allowed": false,
      "missing_credential_policy": "fail_closed_with_explicit_diagnostic"
    },
    "required_pull_request_gates": [
      {
        "id": "design_artifact_gate",
        "command": "python3 scripts/validate_pr_design_gate.py --base <base_sha> --head <head_sha>"
      },
      {
        "id": "validate_harness",
        "command": "python3 scripts/validate_harness.py --skip-remote-guard"
      },
      {
        "id": "learning_events_contract_regressions",
        "command": "python3 scripts/test_learning_events_contract.py"
      },
      {
        "id": "learning_scheduler_contract_regressions",
        "command": "python3 scripts/test_learning_scheduler_contract.py"
      },
      {
        "id": "exact_head_model_review_record",
        "command": "node scripts/validate_model_review.mjs --head <head_sha>"
      },
      {
        "id": "launch_readiness_governance",
        "command": "node --test scripts/test_validate_launch_readiness.mjs && node scripts/validate_launch_readiness.mjs"
      },
      {
        "id": "trusted_media_run_receipt",
        "command": "node --test scripts/test_verify_trusted_media_run_receipt.mjs"
      },
      {
        "id": "maestro_selector_guard",
        "command": "python3 scripts/validate_maestro_selectors.py"
      },
      {
        "id": "mobile_lint",
        "command": "cd apps/mobile && npm run lint -- --quiet"
      },
      {
        "id": "mobile_typecheck",
        "command": "cd apps/mobile && npm run typecheck"
      },
      {
        "id": "mobile_test",
        "command": "cd apps/mobile && npm test -- --runInBand --watchAll=false"
      },
      {
        "id": "backend_contract_test",
        "command": "cd infra/cloudbase/functions/softbook-api && npm test"
      },
      {
        "id": "dependency_security",
        "command": "node scripts/validate_dependency_security.mjs"
      },
      {
        "id": "ios_release",
        "command": "cd apps/mobile && bundle install && git diff --exit-code -- Gemfile.lock && bundle exec pod install --project-directory=ios --deployment && xcodebuild Release simulator build and unsigned archive"
      },
      {
        "id": "android_release",
        "command": "cd apps/mobile && JDK 17 npm run android:release:unsigned && verify app-release-unsigned.apk exists"
      },
      {
        "id": "repository_health",
        "command": "node scripts/report_repo_health.mjs --base <base_sha> --strict"
      },
      {
        "id": "agent_run_evidence_archive",
        "command": "node --test scripts/test_validate_agent_run_evidence.mjs && node scripts/validate_agent_run_evidence.mjs --verify-remote"
      },
      {
        "id": "machine_owned_acceptance",
        "command": "Review the exact diff against task risks and observed outcomes, record the concise decision in the PR, and complete task-relevant required checks. Use additional perspectives or perturbations when they can resolve a concrete remaining risk."
      }
    ]
  }
}
